        <mxCell id="legend" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;" value="&lt;b&gt;Leyenda:&lt;/b&gt;&amp;nbsp; &lt;font color=&#39;#1f6feb&#39;&gt;■ flujo VPN&lt;/font&gt; &amp;nbsp;·&amp;nbsp; &lt;font color=&#39;#9b59b6&#39;&gt;■ autenticación LDAP&lt;/font&gt; &amp;nbsp;·&amp;nbsp; &lt;font color=&#39;#e65100&#39;&gt;■ rutas UDR / salida a Internet (NAT)&lt;/font&gt; &amp;nbsp;·&amp;nbsp; &lt;font color=&#39;#2e7d32&#39;&gt;■ web pública&lt;/font&gt; &amp;nbsp;·&amp;nbsp; &lt;font color=&#39;#888888&#39;&gt;■ servicios y respaldos&lt;/font&gt; &amp;nbsp;·&amp;nbsp; punteado = retorno o secundario &amp;nbsp;·&amp;nbsp; los números ①–⑨ se explican en la tabla de flujo" vertex="1">
          <mxGeometry height="30" width="1660" x="20" y="890" as="geometry" />
        </mxCell>
        <mxCell id="tflujo" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" value="&lt;b style=&#39;font-size:15px&#39;&gt;Flujo paso a paso&lt;/b&gt;&lt;table border=&#39;1&#39; cellpadding=&#39;5&#39; style=&#39;border-collapse:collapse;width:100%;font-size:12px;margin-top:8px&#39;&gt;&lt;tr&gt;&lt;td&gt;①&lt;/td&gt;&lt;td&gt;El empleado abre el túnel OpenVPN (UDP 1194) hacia la IP pública de fw-vpn.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;②&lt;/td&gt;&lt;td&gt;fw-vpn valida usuario y contraseña contra OpenLDAP (srv-planos:636).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;③&lt;/td&gt;&lt;td&gt;Según su grupo LDAP, OpenVPN le asigna una IP del pool de su departamento.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;④&lt;/td&gt;&lt;td&gt;Cada paquete pasa por nftables, que revisa origen (pool) y destino/puerto contra la ACL.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;⑤&lt;/td&gt;&lt;td&gt;Si se permite, fw-vpn lo reenvía al servidor (ej. SSH 22 a srv-render). Sin NAT interno: el servidor ve la IP real 10.10.1.x.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;⑥&lt;/td&gt;&lt;td&gt;El servidor responde a 10.10.1.x; la UDR de Servidores manda la respuesta a fw-vpn, que la mete al túnel.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;⑦&lt;/td&gt;&lt;td&gt;Los servidores salen a Internet por la UDR 0.0.0.0/0 → fw-vpn, que hace NAT con su IP pública.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;⑧&lt;/td&gt;&lt;td&gt;El público entra a la web por HTTPS 443 a la IP pública de la web (por eso la DMZ no lleva ruta 0/0 a fw-vpn).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;⑨&lt;/td&gt;&lt;td&gt;srv-planos respalda planos y expedientes en Blob Storage.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="360" width="810" x="20" y="950" as="geometry" />
        </mxCell>
        <mxCell id="tip" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" value="&lt;b style=&#39;font-size:15px&#39;&gt;Plan de direccionamiento&lt;/b&gt;&lt;table border=&#39;1&#39; cellpadding=&#39;5&#39; style=&#39;border-collapse:collapse;width:100%;font-size:12px;margin-top:8px&#39;&gt;&lt;tr&gt;&lt;th&gt;Subred&lt;/th&gt;&lt;th&gt;Dónde&lt;/th&gt;&lt;th&gt;Rango&lt;/th&gt;&lt;th&gt;IP útiles&lt;/th&gt;&lt;th&gt;Equipos&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;DMZ&lt;/td&gt;&lt;td&gt;Azure&lt;/td&gt;&lt;td&gt;10.0.0.0/28&lt;/td&gt;&lt;td&gt;11&lt;/td&gt;&lt;td&gt;web 10.0.0.4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Firewall&lt;/td&gt;&lt;td&gt;Azure&lt;/td&gt;&lt;td&gt;10.0.0.16/28&lt;/td&gt;&lt;td&gt;11&lt;/td&gt;&lt;td&gt;fw-vpn 10.0.0.20&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Servidores&lt;/td&gt;&lt;td&gt;Azure&lt;/td&gt;&lt;td&gt;10.0.0.32/28&lt;/td&gt;&lt;td&gt;11&lt;/td&gt;&lt;td&gt;srv-planos 10.0.0.36, srv-render 10.0.0.37&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Arquitectos&lt;/td&gt;&lt;td&gt;VPN&lt;/td&gt;&lt;td&gt;10.10.1.0/27&lt;/td&gt;&lt;td&gt;30&lt;/td&gt;&lt;td&gt;.1 a .15&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Ingenieros&lt;/td&gt;&lt;td&gt;VPN&lt;/td&gt;&lt;td&gt;10.10.1.32/28&lt;/td&gt;&lt;td&gt;14&lt;/td&gt;&lt;td&gt;.33 a .42&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;TI&lt;/td&gt;&lt;td&gt;VPN&lt;/td&gt;&lt;td&gt;10.10.1.48/29&lt;/td&gt;&lt;td&gt;6&lt;/td&gt;&lt;td&gt;.49 a .51&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&#39;font-size:11px;margin-top:6px&#39;&gt;Azure reserva 5 IP por subred (la primera usable es la .4). OpenVPN usa 10.10.0.0/23 y el servidor toma 10.10.0.1.&lt;/div&gt;" vertex="1">
          <mxGeometry height="300" width="810" x="918" y="950" as="geometry" />
        </mxCell>
        <mxCell id="tudr" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" value="&lt;b style=&#39;font-size:15px&#39;&gt;Tablas de rutas (UDR)&lt;/b&gt;&lt;table border=&#39;1&#39; cellpadding=&#39;5&#39; style=&#39;border-collapse:collapse;width:100%;font-size:12px;margin-top:8px&#39;&gt;&lt;tr&gt;&lt;th&gt;Tabla&lt;/th&gt;&lt;th&gt;Destino&lt;/th&gt;&lt;th&gt;Siguiente salto&lt;/th&gt;&lt;th&gt;Para qué&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;UDR Servidores&lt;/td&gt;&lt;td&gt;0.0.0.0/0&lt;/td&gt;&lt;td&gt;10.0.0.20&lt;/td&gt;&lt;td&gt;Salida a Internet con NAT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;UDR Servidores&lt;/td&gt;&lt;td&gt;10.10.0.0/23&lt;/td&gt;&lt;td&gt;10.0.0.20&lt;/td&gt;&lt;td&gt;Respuestas a usuarios VPN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;UDR Servidores&lt;/td&gt;&lt;td&gt;10.0.0.0/28&lt;/td&gt;&lt;td&gt;10.0.0.20&lt;/td&gt;&lt;td&gt;Tráfico hacia la DMZ pasa por el firewall&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;UDR DMZ&lt;/td&gt;&lt;td&gt;10.0.0.32/28&lt;/td&gt;&lt;td&gt;10.0.0.20&lt;/td&gt;&lt;td&gt;Tráfico hacia Servidores pasa por el firewall&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;UDR DMZ&lt;/td&gt;&lt;td&gt;10.10.0.0/23&lt;/td&gt;&lt;td&gt;10.0.0.20&lt;/td&gt;&lt;td&gt;Tráfico hacia usuarios VPN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;UDR DMZ&lt;/td&gt;&lt;td&gt;sin 0.0.0.0/0&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;La web responde por su propia IP pública&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Subred Firewall&lt;/td&gt;&lt;td&gt;sin UDR&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;Evita que fw-vpn se mande tráfico a sí mismo&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&#39;font-size:11px;margin-top:6px&#39;&gt;Requisito en Azure: IP forwarding activo en la NIC de fw-vpn y su IP privada estática.&lt;/div&gt;" vertex="1">
          <mxGeometry height="330" width="810" x="20" y="1350" as="geometry" />
        </mxCell>
        <mxCell id="tacl" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" value="&lt;b style=&#39;font-size:15px&#39;&gt;ACL (nftables en fw-vpn + NSG de Servidores)&lt;/b&gt;&lt;table border=&#39;1&#39; cellpadding=&#39;5&#39; style=&#39;border-collapse:collapse;width:100%;font-size:12px;margin-top:8px&#39;&gt;&lt;tr&gt;&lt;th&gt;Origen → Destino&lt;/th&gt;&lt;th&gt;srv-planos&lt;/th&gt;&lt;th&gt;srv-render&lt;/th&gt;&lt;th&gt;DNS / NTP&lt;/th&gt;&lt;th&gt;TI&lt;/th&gt;&lt;th&gt;Internet&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Arquitectos&lt;/td&gt;&lt;td&gt;✔ SMB 445, SSH 22&lt;/td&gt;&lt;td&gt;✔ SSH 22&lt;/td&gt;&lt;td&gt;✔&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;✔ NAT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Ingenieros&lt;/td&gt;&lt;td&gt;✔ SMB 445, SSH 22&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;✔&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;✔ NAT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;TI&lt;/td&gt;&lt;td&gt;✔ todo&lt;/td&gt;&lt;td&gt;✔ todo&lt;/td&gt;&lt;td&gt;✔&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;✔ NAT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;DMZ (web)&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;✔&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;✔&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;fw-vpn&lt;/td&gt;&lt;td&gt;✔ LDAP 636&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;✔&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Internet&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;solo 443 → web y UDP 1194 → fw-vpn&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&#39;font-size:11px;margin-top:6px&#39;&gt;Política por defecto DROP. Las conexiones establecidas sí regresan: TI recibe sus respuestas, pero nadie puede iniciar conexión hacia TI. Hardening: solo quedan abiertos los puertos de esta tabla.&lt;/div&gt;" vertex="1">
          <mxGeometry height="340" width="810" x="870" y="1290" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
