        <mxCell id="e11" edge="1" parent="1" source="dnspub" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#888888;strokeWidth=1;dashed=1;dashPattern=1 3;fontColor=#8a94a3;fontSize=10;labelBackgroundColor=default;endArrow=none;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.95;entryY=0.5;entryDx=0;entryDy=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;" target="internet" value="resuelve dominio">
