<mxfile host="app.diagrams.net"><diagram name="Fase 3" id="fase3-terranova"><mxGraphModel grid="0" page="0" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Caso 4 · Desarrolladora de bienes raíces — Red en Azure (Proyecto Final, Fase 3: servicios y seguridad)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" width="1300" height="40" as="geometry"/></mxCell>
<mxCell id="internet" value="&lt;b&gt;Internet&lt;/b&gt;" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;" vertex="1" parent="1"><mxGeometry x="820" y="50" width="220" height="120" as="geometry"/></mxCell>
<mxCell id="dnspub" value="&lt;b&gt;Azure DNS&lt;/b&gt; (zona pública .me)&lt;br&gt;&lt;i&gt;fase final, no implementado&lt;/i&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=https://app.diagrams.net/img/lib/azure2/networking/DNS_Zones.svg;opacity=40;textOpacity=70;" vertex="1" parent="1"><mxGeometry x="1200" y="60" width="64" height="64" as="geometry"/></mxCell>
<mxCell id="blob" value="&lt;b&gt;Blob Storage&lt;/b&gt;&lt;br&gt;respaldos&lt;br&gt;&lt;i&gt;fase final, no implementado&lt;/i&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=https://app.diagrams.net/img/lib/azure2/storage/Storage_Accounts.svg;opacity=40;textOpacity=70;" vertex="1" parent="1"><mxGeometry x="1500" y="65" width="65" height="52" as="geometry"/></mxCell>
<mxCell id="users" value="&lt;b&gt;Usuarios remotos (oficina, casa o sala de ventas)&lt;/b&gt;&lt;br&gt;4 instancias de OpenVPN · una por grupo · UDP 1194–1197" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e5;strokeColor=#b45309;dashed=1;verticalAlign=top;fontSize=13;arcSize=3;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="340" height="700" as="geometry"/></mxCell>
<mxCell id="arq" value="&lt;b&gt;Arquitectos&lt;/b&gt; (15)&lt;br&gt;10.10.1.0/27 · UDP 1194&lt;br&gt;pool .2 – .30" style="image;html=1;image=https://app.diagrams.net/img/lib/clip_art/computers/Laptop_128x128.png;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="55" y="300" width="70" height="70" as="geometry"/></mxCell>
<mxCell id="ing" value="&lt;b&gt;Ingenieros&lt;/b&gt; (10)&lt;br&gt;10.10.1.32/28 · UDP 1195&lt;br&gt;pool .34 – .46" style="image;html=1;image=https://app.diagrams.net/img/lib/clip_art/computers/Laptop_128x128.png;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="55" y="430" width="70" height="70" as="geometry"/></mxCell>
<mxCell id="ti" value="&lt;b&gt;TI&lt;/b&gt; (3)&lt;br&gt;10.10.1.48/29 · UDP 1196&lt;br&gt;pool .50 – .54&lt;br&gt;&lt;font color=&quot;#e67e22&quot;&gt;nadie inicia conexión hacia TI&lt;/font&gt;" style="image;html=1;image=https://app.diagrams.net/img/lib/clip_art/computers/Laptop_128x128.png;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="55" y="560" width="70" height="70" as="geometry"/></mxCell>
<mxCell id="vis" value="&lt;b&gt;Visitantes&lt;/b&gt; (nueva, Fase 3)&lt;br&gt;10.10.1.64/28 · UDP 1197&lt;br&gt;pool .66 – .78&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;solo Internet, nada interno&lt;/font&gt;" style="image;html=1;image=https://app.diagrams.net/img/lib/clip_art/computers/Laptop_128x128.png;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="55" y="690" width="70" height="70" as="geometry"/></mxCell>
<mxCell id="step3" value="&lt;b&gt;②③&lt;/b&gt; Al conectar, la instancia valida usuario y clave en OpenLDAP, revisa que sea de su grupo y le da una IP dinámica de su pool (DHCP de la VPN)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1f6feb;fontSize=11;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="300" height="85" as="geometry"/></mxCell>
<mxCell id="vnet" value="&lt;b&gt;VNet 10.0.0.0/16&lt;/b&gt; · Azure for Students · North Central US · DHCP de Azure para las VMs (IP fija)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3fb;strokeColor=#0078d4;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;arcSize=2;" vertex="1" parent="1"><mxGeometry x="420" y="230" width="1260" height="700" as="geometry"/></mxCell>
<mxCell id="sdmz" value="&lt;b&gt;Subred DMZ&lt;/b&gt;&lt;br&gt;10.0.0.0/28" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#2e7d32;dashed=1;verticalAlign=top;fontSize=12;arcSize=3;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="450" y="280" width="300" height="620" as="geometry"/></mxCell>
<mxCell id="sfw" value="&lt;b&gt;Subred Firewall&lt;/b&gt;&lt;br&gt;10.0.0.16/28" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0f766e;dashed=1;verticalAlign=top;fontSize=12;arcSize=3;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="810" y="280" width="370" height="620" as="geometry"/></mxCell>
<mxCell id="ssrv" value="&lt;b&gt;Subred Servidores&lt;/b&gt;&lt;br&gt;10.0.0.32/28" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8e44ad;dashed=1;verticalAlign=top;fontSize=12;arcSize=3;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1240" y="280" width="410" height="620" as="geometry"/></mxCell>
<mxCell id="dmztxt" value="&lt;b&gt;Vacía&lt;/b&gt;&lt;br&gt;Reservada para la web pública (Nginx + Certbot) de la fase final.&lt;br&gt;&lt;br&gt;Sin cuota: Azure for Students tiene 6 de 6 vCPU usadas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="485" y="470" width="230" height="140" as="geometry"/></mxCell>
<mxCell id="nsgdmz" value="NSG DMZ&lt;br&gt;sin entrada desde Internet" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=https://app.diagrams.net/img/lib/azure2/networking/Network_Security_Groups.svg;" vertex="1" parent="1"><mxGeometry x="500" y="790" width="28" height="34" as="geometry"/></mxCell>
<mxCell id="nodmz" value="Sin UDR&lt;br&gt;(subred vacía)" style="text;html=1;fontSize=10;align=center;verticalAlign=middle;fontColor=#8a94a3;" vertex="1" parent="1"><mxGeometry x="620" y="790" width="90" height="40" as="geometry"/></mxCell>
<mxCell id="pipfw" value="IP pública fw-vpn" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=https://app.diagrams.net/img/lib/azure2/networking/Public_IP_Addresses.svg;" vertex="1" parent="1"><mxGeometry x="963" y="350" width="65" height="52" as="geometry"/></mxCell>
<mxCell id="fw" value="&lt;b&gt;fw-vpn&lt;/b&gt; · 10.0.0.20 (IP fija) · B2ats_v2&lt;hr&gt;• OpenVPN ×4: UDP 1194–1197 (login LDAP, IP por grupo)&lt;br&gt;• &lt;b&gt;④ nftables revisa la ACL&lt;/b&gt; (forward, política DROP)&lt;br&gt;• NAT (masquerade) hacia Internet&lt;br&gt;• IP forwarding (Linux + NIC de Azure)&lt;br&gt;• chrony: servidor NTP de la red&lt;br&gt;• Hardening: input DROP, SSH solo admin y TI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f3f0;strokeColor=#0f766e;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=11;arcSize=5;" vertex="1" parent="1"><mxGeometry x="850" y="470" width="290" height="230" as="geometry"/></mxCell>
<mxCell id="nsgfw" value="NSG Firewall&lt;br&gt;UDP 1194–1197 desde Internet&lt;br&gt;SSH solo admin · salida VPN → red" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=https://app.diagrams.net/img/lib/azure2/networking/Network_Security_Groups.svg;" vertex="1" parent="1"><mxGeometry x="880" y="790" width="28" height="34" as="geometry"/></mxCell>
<mxCell id="noudr" value="Sin UDR&lt;br&gt;(evita loop)" style="text;html=1;fontSize=10;align=center;verticalAlign=middle;fontColor=#8a94a3;" vertex="1" parent="1"><mxGeometry x="1050" y="790" width="90" height="40" as="geometry"/></mxCell>
<mxCell id="planos" value="&lt;b&gt;srv-planos&lt;/b&gt; · 10.0.0.36&lt;br&gt;OpenLDAP 389 (usuarios y grupos)&lt;br&gt;SSH 22 con usuarios LDAP (SSSD)&lt;br&gt;NTP desde fw-vpn · B2ats_v2&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#8a94a3&quot;&gt;Samba 445: fase final&lt;/font&gt;&lt;/i&gt;" style="image;aspect=fixed;html=1;points=[];fontSize=11;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=10;image=https://app.diagrams.net/img/lib/azure2/compute/Virtual_Machine.svg;" vertex="1" parent="1"><mxGeometry x="1290" y="370" width="69" height="64" as="geometry"/></mxCell>
<mxCell id="render" value="&lt;b&gt;srv-render&lt;/b&gt; · 10.0.0.37&lt;br&gt;nginx: intranet HTTP 80 (solo interno)&lt;br&gt;SSH 22 con usuarios LDAP (SSSD)&lt;br&gt;NTP desde fw-vpn · B2ats_v2&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#8a94a3&quot;&gt;Blender Cycles: fase final&lt;/font&gt;&lt;/i&gt;" style="image;aspect=fixed;html=1;points=[];fontSize=11;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=10;image=https://app.diagrams.net/img/lib/azure2/compute/Virtual_Machine.svg;" vertex="1" parent="1"><mxGeometry x="1290" y="570" width="69" height="64" as="geometry"/></mxCell>
<mxCell id="intra" value="render → planos (LDAP para SSSD) van en la misma subred: lo filtra el NSG, no pasa por fw-vpn. La intranet comparte VM con render por la cuota de vCPU." style="text;html=1;whiteSpace=wrap;fontSize=10;fontColor=#8a94a3;align=left;" vertex="1" parent="1"><mxGeometry x="1290" y="680" width="330" height="50" as="geometry"/></mxCell>
<mxCell id="nsgsrv" value="NSG Servidores&lt;br&gt;reglas por grupo&lt;br&gt;Visitantes bloqueado" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=https://app.diagrams.net/img/lib/azure2/networking/Network_Security_Groups.svg;" vertex="1" parent="1"><mxGeometry x="1300" y="790" width="28" height="34" as="geometry"/></mxCell>
<mxCell id="rtsrv" value="UDR Servidores (rt-servidores)&lt;br&gt;10.10.0.0/16 y 0.0.0.0/0 → 10.0.0.20" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=https://app.diagrams.net/img/lib/azure2/networking/Route_Tables.svg;" vertex="1" parent="1"><mxGeometry x="1540" y="790" width="36" height="35" as="geometry"/></mxCell>
<mxCell id="e1" value="① túnel cifrado OpenVPN (UDP 1194–1197)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1f6feb;strokeWidth=2;fontColor=#1f6feb;fontSize=11;endArrow=classic;" edge="1" parent="1" source="users" target="internet"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="190" y="110"/></Array></mxGeometry></mxCell>
<mxCell id="e2" value="①" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1f6feb;strokeWidth=2;fontColor=#1f6feb;fontSize=12;endArrow=classic;" edge="1" parent="1" source="internet" target="pipfw"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1f6feb;strokeWidth=2;endArrow=classic;" edge="1" parent="1" source="pipfw" target="fw"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="② LDAP 389 (login VPN)&lt;br&gt;⑤ SSH 22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9b59b6;strokeWidth=2;fontColor=#9b59b6;fontSize=11;endArrow=classic;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fw" target="planos"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" value="⑤ HTTP 80 · SSH 22 (según ACL)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1f6feb;strokeWidth=2;fontColor=#1f6feb;fontSize=11;endArrow=classic;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fw" target="render"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" value="⑥ ⑦ UDR: respuestas VPN y salida a Internet → fw-vpn" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#e65100;strokeWidth=1.5;dashed=1;fontColor=#e65100;fontSize=11;endArrow=classic;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="rtsrv" target="fw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1558" y="760"/><mxPoint x="1068" y="760"/></Array></mxGeometry></mxCell>
<mxCell id="e7" value="⑦ NAT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#e65100;strokeWidth=2;fontColor=#e65100;fontSize=11;endArrow=classic;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.85;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="pipfw" target="internet"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e8" value="⑧ LDAP (SSSD)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9b59b6;strokeWidth=1.5;dashed=1;fontColor=#9b59b6;fontSize=10;endArrow=classic;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="render" target="planos"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e11" value="resuelve dominio (fase final)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#888888;strokeWidth=1;dashed=1;dashPattern=1 3;fontColor=#8a94a3;fontSize=10;endArrow=none;" edge="1" parent="1" source="dnspub" target="internet"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="legend" value="&lt;b&gt;Leyenda:&lt;/b&gt;&amp;nbsp; &lt;font color=&quot;#1f6feb&quot;&gt;■ flujo VPN y acceso a servicios&lt;/font&gt; &amp;nbsp;·&amp;nbsp; &lt;font color=&quot;#9b59b6&quot;&gt;■ autenticación LDAP&lt;/font&gt; &amp;nbsp;·&amp;nbsp; &lt;font color=&quot;#e65100&quot;&gt;■ rutas UDR / salida a Internet (NAT)&lt;/font&gt; &amp;nbsp;·&amp;nbsp; punteado = retorno o secundario &amp;nbsp;·&amp;nbsp; gris/transparente = diseño para la fase final, no implementado &amp;nbsp;·&amp;nbsp; los números ①–⑨ se explican en la tabla de flujo" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="950" width="1660" height="30" as="geometry"/></mxCell>
<mxCell id="tflujo" value="&lt;b style=&#39;font-size:15px&#39;&gt;Flujo paso a paso&lt;/b&gt;&lt;table border=&#39;1&#39; cellpadding=&#39;5&#39; style=&#39;border-collapse:collapse;width:100%;font-size:12px;margin-top:8px&#39;&gt;&lt;tr&gt;&lt;td&gt;①&lt;/td&gt;&lt;td&gt;El empleado abre el túnel OpenVPN de su grupo (1194 Arquitectos, 1195 Ingenieros, 1196 TI, 1197 Visitantes) hacia la IP pública de fw-vpn.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;②&lt;/td&gt;&lt;td&gt;fw-vpn valida usuario y contraseña contra OpenLDAP (srv-planos:389) y que el usuario sea del grupo de esa instancia.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;③&lt;/td&gt;&lt;td&gt;La instancia le asigna una IP dinámica del pool de su grupo (por ejemplo, Arquitectos 10.10.1.2) y le empuja la ruta 10.0.0.0/16.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;④&lt;/td&gt;&lt;td&gt;Cada paquete pasa por nftables (cadena forward), que revisa origen, destino y puerto contra la ACL.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;⑤&lt;/td&gt;&lt;td&gt;Si se permite, llega al servidor con su IP real (sin NAT interno): SSH 22 o la intranet HTTP 80 en srv-render.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;⑥&lt;/td&gt;&lt;td&gt;El servidor responde a 10.10.1.x; la UDR de Servidores lo manda a fw-vpn, que lo regresa por el túnel.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;⑦&lt;/td&gt;&lt;td&gt;Servidores y VPN salen a Internet por fw-vpn, que hace NAT con su IP pública. Visitantes solo tiene esta salida.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;⑧&lt;/td&gt;&lt;td&gt;srv-planos y srv-render autentican SSH con usuarios de LDAP (SSSD); cada servidor solo acepta a sus grupos.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;⑨&lt;/td&gt;&lt;td&gt;NTP: fw-vpn toma la hora de Azure y srv-planos y srv-render se sincronizan con 10.0.0.20 (UDP 123).&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1000" width="810" height="390" as="geometry"/></mxCell>
<mxCell id="tip" value="&lt;b style=&#39;font-size:15px&#39;&gt;Plan de direccionamiento&lt;/b&gt;&lt;table border=&#39;1&#39; cellpadding=&#39;5&#39; style=&#39;border-collapse:collapse;width:100%;font-size:12px;margin-top:8px&#39;&gt;&lt;tr&gt;&lt;th&gt;Subred&lt;/th&gt;&lt;th&gt;Dónde&lt;/th&gt;&lt;th&gt;Rango&lt;/th&gt;&lt;th&gt;IP útiles&lt;/th&gt;&lt;th&gt;Equipos&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;DMZ&lt;/td&gt;&lt;td&gt;Azure&lt;/td&gt;&lt;td&gt;10.0.0.0/28&lt;/td&gt;&lt;td&gt;11&lt;/td&gt;&lt;td&gt;vacía (fase final: web)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Firewall&lt;/td&gt;&lt;td&gt;Azure&lt;/td&gt;&lt;td&gt;10.0.0.16/28&lt;/td&gt;&lt;td&gt;11&lt;/td&gt;&lt;td&gt;fw-vpn 10.0.0.20&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Servidores&lt;/td&gt;&lt;td&gt;Azure&lt;/td&gt;&lt;td&gt;10.0.0.32/28&lt;/td&gt;&lt;td&gt;11&lt;/td&gt;&lt;td&gt;srv-planos 10.0.0.36, srv-render 10.0.0.37&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Arquitectos&lt;/td&gt;&lt;td&gt;VPN&lt;/td&gt;&lt;td&gt;10.10.1.0/27&lt;/td&gt;&lt;td&gt;30&lt;/td&gt;&lt;td&gt;servidor .1 · laptops .2 a .30 · UDP 1194&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Ingenieros&lt;/td&gt;&lt;td&gt;VPN&lt;/td&gt;&lt;td&gt;10.10.1.32/28&lt;/td&gt;&lt;td&gt;14&lt;/td&gt;&lt;td&gt;servidor .33 · laptops .34 a .46 · UDP 1195&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;TI&lt;/td&gt;&lt;td&gt;VPN&lt;/td&gt;&lt;td&gt;10.10.1.48/29&lt;/td&gt;&lt;td&gt;6&lt;/td&gt;&lt;td&gt;servidor .49 · laptops .50 a .54 · UDP 1196&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Visitantes&lt;/td&gt;&lt;td&gt;VPN&lt;/td&gt;&lt;td&gt;10.10.1.64/28&lt;/td&gt;&lt;td&gt;14&lt;/td&gt;&lt;td&gt;servidor .65 · laptops .66 a .78 · UDP 1197&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&#39;font-size:11px;margin-top:6px&#39;&gt;Azure reserva 5 IP por subred, por eso la primera usable es la .4. DHCP: Azure da la IP a las VMs; cada instancia de OpenVPN da IPs dinámicas de su pool a las laptops.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="870" y="1000" width="810" height="320" as="geometry"/></mxCell>
<mxCell id="tudr" value="&lt;b style=&#39;font-size:15px&#39;&gt;Tablas de rutas (UDR)&lt;/b&gt;&lt;table border=&#39;1&#39; cellpadding=&#39;5&#39; style=&#39;border-collapse:collapse;width:100%;font-size:12px;margin-top:8px&#39;&gt;&lt;tr&gt;&lt;th&gt;Tabla&lt;/th&gt;&lt;th&gt;Destino&lt;/th&gt;&lt;th&gt;Siguiente salto&lt;/th&gt;&lt;th&gt;Para qué&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;rt-servidores&lt;/td&gt;&lt;td&gt;10.10.0.0/16&lt;/td&gt;&lt;td&gt;10.0.0.20&lt;/td&gt;&lt;td&gt;Respuestas a los usuarios de la VPN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;rt-servidores&lt;/td&gt;&lt;td&gt;0.0.0.0/0&lt;/td&gt;&lt;td&gt;10.0.0.20&lt;/td&gt;&lt;td&gt;Salida a Internet con NAT (la subred no tiene salida por defecto)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Subred DMZ&lt;/td&gt;&lt;td&gt;sin UDR&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;Está vacía&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Subred Firewall&lt;/td&gt;&lt;td&gt;sin UDR&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;Evita que fw-vpn se mande tráfico a sí mismo&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&#39;font-size:11px;margin-top:6px&#39;&gt;Requisitos en Azure: IP forwarding en la NIC de fw-vpn, su IP privada estática y la regla de salida Allow-VPN-Hacia-Red en nsg-firewall. Las subredes temporales de departamentos de la Fase 2 se borraron: su ruta local le ganaba a 10.10.0.0/16.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1420" width="810" height="260" as="geometry"/></mxCell>
<mxCell id="tacl" value="&lt;b style=&#39;font-size:15px&#39;&gt;ACL (nftables en fw-vpn + NSG + firewall de cada servidor)&lt;/b&gt;&lt;table border=&#39;1&#39; cellpadding=&#39;5&#39; style=&#39;border-collapse:collapse;width:100%;font-size:12px;margin-top:8px&#39;&gt;&lt;tr&gt;&lt;th&gt;Origen → Destino&lt;/th&gt;&lt;th&gt;srv-planos&lt;/th&gt;&lt;th&gt;srv-render&lt;/th&gt;&lt;th&gt;Intranet&lt;/th&gt;&lt;th&gt;TI&lt;/th&gt;&lt;th&gt;Internet&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Arquitectos&lt;/td&gt;&lt;td&gt;✔ SSH 22&lt;/td&gt;&lt;td&gt;✔ SSH 22&lt;/td&gt;&lt;td&gt;✔&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;✔ NAT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Ingenieros&lt;/td&gt;&lt;td&gt;✔ SSH 22&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;✔&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;✔ NAT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;TI&lt;/td&gt;&lt;td&gt;✔ todo&lt;/td&gt;&lt;td&gt;✔ todo&lt;/td&gt;&lt;td&gt;✔&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;✔ NAT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Visitantes&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;✔ NAT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Servidores&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;✔&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;✔ NAT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;fw-vpn&lt;/td&gt;&lt;td&gt;✔ LDAP 389, SSH&lt;/td&gt;&lt;td&gt;✔ SSH&lt;/td&gt;&lt;td&gt;✔&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;✔&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Internet&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;solo UDP 1194–1197 → fw-vpn&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&#39;font-size:11px;margin-top:6px&#39;&gt;Política por defecto: DROP. Nadie puede iniciar conexión hacia TI; TI sí recibe sus respuestas. Samba 445 y Blender quedan para la fase final.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="870" y="1360" width="810" height="320" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
