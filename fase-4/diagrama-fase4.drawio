<mxfile host="app.diagrams.net"><diagram name="Fase 4" id="fase4-terranova"><mxGraphModel grid="0" page="0" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Caso 4 · Desarrolladora de bienes raíces — Red en Azure (Proyecto Final, Fase 4: parte pública, DMZ y monitoreo)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1500" height="40" as="geometry"/></mxCell>
<mxCell id="internet" value="&lt;b&gt;Internet&lt;/b&gt;" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;" vertex="1" parent="1"><mxGeometry x="820" y="50" width="220" height="120" as="geometry"/></mxCell>
<mxCell id="publico" value="&lt;b&gt;Público&lt;/b&gt; (compradores, clientes)&lt;br&gt;celular o PC, sin VPN&lt;br&gt;&lt;font color=&#x27;#2e7d32&#x27;&gt;https://terranova-inmobiliaria.me&lt;/font&gt;" style="image;html=1;image=https://app.diagrams.net/img/lib/clip_art/computers/Laptop_128x128.png;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1420" y="70" width="70" height="70" as="geometry"/></mxCell>
<mxCell id="dnspub" value="&lt;b&gt;Dominio público&lt;/b&gt;&lt;br&gt;terranova-inmobiliaria.me&lt;br&gt;registro A → IP pública de fw-vpn" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=https://app.diagrams.net/img/lib/azure2/networking/DNS_Zones.svg;" vertex="1" parent="1"><mxGeometry x="1130" y="75" width="64" height="64" as="geometry"/></mxCell>
<mxCell id="users" value="&lt;b&gt;Usuarios remotos (oficina, casa u obra)&lt;/b&gt;&lt;br&gt;4 instancias de OpenVPN · una por grupo · UDP 1194–1197" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e5;strokeColor=#b45309;dashed=1;verticalAlign=top;fontSize=13;arcSize=3;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="340" height="700" as="geometry"/></mxCell>
<mxCell id="arq" value="&lt;b&gt;Arquitectos&lt;/b&gt; (15)&lt;br&gt;10.10.1.0/27 · UDP 1194&lt;br&gt;pool .2 – .30&lt;br&gt;DNS interno 10.0.0.20" style="image;html=1;image=https://app.diagrams.net/img/lib/clip_art/computers/Laptop_128x128.png;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="55" y="300" width="70" height="70" as="geometry"/></mxCell>
<mxCell id="ing" value="&lt;b&gt;Ingenieros&lt;/b&gt; (10)&lt;br&gt;10.10.1.32/28 · UDP 1195&lt;br&gt;pool .34 – .46&lt;br&gt;DNS interno 10.0.0.20" style="image;html=1;image=https://app.diagrams.net/img/lib/clip_art/computers/Laptop_128x128.png;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="55" y="430" width="70" height="70" as="geometry"/></mxCell>
<mxCell id="ti" value="&lt;b&gt;TI&lt;/b&gt; (3)&lt;br&gt;10.10.1.48/29 · UDP 1196&lt;br&gt;pool .50 – .54 · ve Grafana&lt;br&gt;&lt;font color=&#x27;#e67e22&#x27;&gt;nadie inicia conexión hacia TI&lt;/font&gt;" style="image;html=1;image=https://app.diagrams.net/img/lib/clip_art/computers/Laptop_128x128.png;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="55" y="560" width="70" height="70" as="geometry"/></mxCell>
<mxCell id="vis" value="&lt;b&gt;Visitantes&lt;/b&gt;&lt;br&gt;10.10.1.64/28 · UDP 1197&lt;br&gt;pool .66 – .78 · DNS 1.1.1.1&lt;br&gt;&lt;font color=&#x27;#c0392b&#x27;&gt;solo Internet y la web pública&lt;/font&gt;" style="image;html=1;image=https://app.diagrams.net/img/lib/clip_art/computers/Laptop_128x128.png;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="55" y="690" width="70" height="70" as="geometry"/></mxCell>
<mxCell id="step3" value="&lt;b&gt;②③&lt;/b&gt; Al conectar, la instancia valida usuario y clave en OpenLDAP, revisa que sea de su grupo, le da una IP dinámica de su pool y le empuja el DNS interno (menos a Visitantes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1f6feb;fontSize=11;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="300" height="95" as="geometry"/></mxCell>
<mxCell id="vnet" value="&lt;b&gt;VNet 10.0.0.0/16&lt;/b&gt; · suscripción de pago por uso · North Central US · DHCP de Azure para las VMs (IP fija)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3fb;strokeColor=#0078d4;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;arcSize=2;" vertex="1" parent="1"><mxGeometry x="420" y="230" width="1260" height="700" as="geometry"/></mxCell>
<mxCell id="sdmz" value="&lt;b&gt;Subred DMZ&lt;/b&gt;&lt;br&gt;10.0.0.0/28" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f8f1;strokeColor=#2e7d32;dashed=1;verticalAlign=top;fontSize=12;arcSize=3;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="450" y="280" width="300" height="620" as="geometry"/></mxCell>
<mxCell id="sfw" value="&lt;b&gt;Subred Firewall&lt;/b&gt;&lt;br&gt;10.0.0.16/28" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0f766e;dashed=1;verticalAlign=top;fontSize=12;arcSize=3;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="810" y="280" width="370" height="620" as="geometry"/></mxCell>
<mxCell id="ssrv" value="&lt;b&gt;Subred Servidores&lt;/b&gt;&lt;br&gt;10.0.0.32/28" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8e44ad;dashed=1;verticalAlign=top;fontSize=12;arcSize=3;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1240" y="280" width="410" height="620" as="geometry"/></mxCell>
<mxCell id="web" value="&lt;b&gt;srv-web&lt;/b&gt; · 10.0.0.4 · B2ats_v2 (nueva)&lt;br&gt;sin IP pública&lt;br&gt;nginx: página de los proyectos&lt;br&gt;HTTPS 443 · Certbot (Let&#x27;s Encrypt)&lt;br&gt;HTTP 80 → redirige a HTTPS&lt;br&gt;SNMPv3 · NTP desde fw-vpn&lt;br&gt;SSH solo desde TI y fw-vpn · sin LDAP" style="image;aspect=fixed;html=1;points=[];fontSize=11;align=center;verticalLabelPosition=bottom;verticalAlign=top;image=https://app.diagrams.net/img/lib/azure2/compute/Virtual_Machine.svg;" vertex="1" parent="1"><mxGeometry x="565" y="400" width="69" height="64" as="geometry"/></mxCell>
<mxCell id="dmzrule" value="&lt;b&gt;DMZ aislada:&lt;/b&gt; srv-web no puede iniciar conexiones hacia Servidores ni hacia la VPN (regla dmz-hacia-interno en fw-vpn). Si la atacan, el atacante solo ve la página pública." style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;fontSize=11;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="470" y="630" width="260" height="95" as="geometry"/></mxCell>
<mxCell id="nsgdmz" value="NSG DMZ&lt;br&gt;80/443 desde cualquiera&lt;br&gt;SSH: TI y fw-vpn · SNMP: colector" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=https://app.diagrams.net/img/lib/azure2/networking/Network_Security_Groups.svg;" vertex="1" parent="1"><mxGeometry x="500" y="790" width="28" height="34" as="geometry"/></mxCell>
<mxCell id="rtdmz" value="UDR DMZ (rt-dmz)&lt;br&gt;0.0.0.0/0, 10.10.0.0/16 y&lt;br&gt;10.0.0.32/28 → 10.0.0.20" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=https://app.diagrams.net/img/lib/azure2/networking/Route_Tables.svg;" vertex="1" parent="1"><mxGeometry x="650" y="790" width="36" height="35" as="geometry"/></mxCell>
<mxCell id="pipfw" value="IP pública fw-vpn&lt;br&gt;(estática)" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=https://app.diagrams.net/img/lib/azure2/networking/Public_IP_Addresses.svg;" vertex="1" parent="1"><mxGeometry x="963" y="330" width="65" height="52" as="geometry"/></mxCell>
<mxCell id="fw" value="&lt;b&gt;fw-vpn&lt;/b&gt; · 10.0.0.20 (IP fija) · B2ats_v2&lt;hr&gt;• OpenVPN ×4: UDP 1194–1197 (login LDAP, IP por grupo)&lt;br&gt;• &lt;b&gt;④ nftables revisa la ACL&lt;/b&gt; (forward, política DROP)&lt;br&gt;• &lt;b&gt;&lt;font color=&#x27;#2e7d32&#x27;&gt;DNAT: 80/443 → srv-web 10.0.0.4&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• NAT (masquerade) hacia Internet&lt;br&gt;• &lt;b&gt;BIND9: zona interna terranova.local&lt;/b&gt; (DNS 53)&lt;br&gt;• chrony: servidor NTP de la red&lt;br&gt;• SNMPv3 (agente)&lt;br&gt;• IP forwarding (Linux + NIC de Azure)&lt;br&gt;• Hardening: input DROP, SSH solo admin y TI, sin root" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f3f0;strokeColor=#0f766e;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=11;arcSize=5;" vertex="1" parent="1"><mxGeometry x="845" y="440" width="300" height="290" as="geometry"/></mxCell>
<mxCell id="nsgfw" value="NSG Firewall&lt;br&gt;UDP 1194–1197 y TCP 80/443 desde Internet&lt;br&gt;SSH solo admin · salida VPN y DNAT → red" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=https://app.diagrams.net/img/lib/azure2/networking/Network_Security_Groups.svg;" vertex="1" parent="1"><mxGeometry x="880" y="790" width="28" height="34" as="geometry"/></mxCell>
<mxCell id="noudr" value="Sin UDR&lt;br&gt;(evita loop)" style="text;html=1;fontSize=10;align=center;verticalAlign=middle;fontColor=#8a94a3;" vertex="1" parent="1"><mxGeometry x="1060" y="790" width="90" height="40" as="geometry"/></mxCell>
<mxCell id="planos" value="&lt;b&gt;srv-planos&lt;/b&gt; · 10.0.0.36 · B2als_v2&lt;br&gt;OpenLDAP 389 (usuarios y grupos)&lt;br&gt;SSH 22 y SFTP con usuarios LDAP (SSSD)&lt;br&gt;/srv/planos: Arquitectos escribe, Ingenieros lee&lt;br&gt;NFS 2049: carpeta de renders&lt;br&gt;Prometheus + snmp_exporter (colector)&lt;br&gt;&lt;b&gt;Grafana 3000: solo TI&lt;/b&gt;&lt;br&gt;SNMPv3 · NTP desde fw-vpn" style="image;aspect=fixed;html=1;points=[];fontSize=11;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=10;image=https://app.diagrams.net/img/lib/azure2/compute/Virtual_Machine.svg;" vertex="1" parent="1"><mxGeometry x="1270" y="340" width="69" height="64" as="geometry"/></mxCell>
<mxCell id="render" value="&lt;b&gt;srv-render&lt;/b&gt; · 10.0.0.37 · B2als_v2&lt;br&gt;&lt;b&gt;Blender&lt;/b&gt; (render por consola)&lt;br&gt;renders → srv-planos por NFS&lt;br&gt;nginx: intranet HTTP 80 (solo interno)&lt;br&gt;SSH 22 con usuarios LDAP (SSSD)&lt;br&gt;SNMPv3 · NTP desde fw-vpn" style="image;aspect=fixed;html=1;points=[];fontSize=11;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=10;image=https://app.diagrams.net/img/lib/azure2/compute/Virtual_Machine.svg;" vertex="1" parent="1"><mxGeometry x="1270" y="570" width="69" height="64" as="geometry"/></mxCell>
<mxCell id="intra" value="render ↔ planos (LDAP, NFS, SNMP) van en la misma subred: los filtra el NSG y el firewall de cada servidor, no pasan por fw-vpn. Tráfico Servidores ↔ DMZ sí pasa por fw-vpn (UDR)." style="text;html=1;whiteSpace=wrap;fontSize=10;fontColor=#8a94a3;align=left;" vertex="1" parent="1"><mxGeometry x="1270" y="700" width="360" height="50" as="geometry"/></mxCell>
<mxCell id="nsgsrv" value="NSG Servidores&lt;br&gt;reglas por grupo&lt;br&gt;DMZ y Visitantes bloqueados" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=https://app.diagrams.net/img/lib/azure2/networking/Network_Security_Groups.svg;" vertex="1" parent="1"><mxGeometry x="1300" y="790" width="28" height="34" as="geometry"/></mxCell>
<mxCell id="rtsrv" value="UDR Servidores (rt-servidores)&lt;br&gt;0.0.0.0/0, 10.10.0.0/16 y&lt;br&gt;10.0.0.0/28 → 10.0.0.20" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=https://app.diagrams.net/img/lib/azure2/networking/Route_Tables.svg;" vertex="1" parent="1"><mxGeometry x="1540" y="790" width="36" height="35" as="geometry"/></mxCell>
<mxCell id="e1" value="① túnel cifrado OpenVPN (UDP 1194–1197)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1f6feb;strokeWidth=2;fontColor=#1f6feb;fontSize=11;endArrow=classic;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="users" target="internet"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="190" y="110"/></Array></mxGeometry></mxCell>
<mxCell id="e2" value="① VPN · Ⓒ HTTP/HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1f6feb;strokeWidth=2;fontColor=#1f6feb;fontSize=11;endArrow=classic;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="internet" target="pipfw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e2b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1f6feb;strokeWidth=2;fontColor=#1f6feb;fontSize=11;endArrow=classic;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pipfw" target="fw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="ea" value="Ⓐ https://terranova-inmobiliaria.me" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2e7d32;strokeWidth=2;fontColor=#2e7d32;fontSize=11;endArrow=classic;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="publico" target="internet"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1455" y="45"/><mxPoint x="930" y="45"/></Array></mxGeometry></mxCell>
<mxCell id="eb" value="Ⓑ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6b7280;strokeWidth=1;fontColor=#6b7280;fontSize=11;endArrow=classic;labelBackgroundColor=#ffffff;dashed=1;dashPattern=1 3;endArrow=none;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dnspub" target="internet"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="ed" value="Ⓓ DNAT 80/443 → 10.0.0.4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2e7d32;strokeWidth=2.5;fontColor=#2e7d32;fontSize=11;endArrow=classic;labelBackgroundColor=#ffffff;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fw" target="web"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="ee" value="Ⓔ respuesta por UDR → fw-vpn" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#e65100;strokeWidth=1.5;fontColor=#e65100;fontSize=11;endArrow=classic;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="rtdmz" target="fw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="668" y="760"/><mxPoint x="800" y="760"/><mxPoint x="800" y="687"/></Array></mxGeometry></mxCell>
<mxCell id="e3" value="② LDAP 389 (login VPN)&lt;br&gt;⑤ SSH 22 / SFTP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9b59b6;strokeWidth=2;fontColor=#9b59b6;fontSize=11;endArrow=classic;labelBackgroundColor=#ffffff;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fw" target="planos"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e4" value="⑤ HTTP 80 · SSH 22 (según ACL)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1f6feb;strokeWidth=2;fontColor=#1f6feb;fontSize=11;endArrow=classic;labelBackgroundColor=#ffffff;exitX=1;exitY=0.55;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fw" target="render"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e5" value="⑥ ⑦ UDR → fw-vpn" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#e65100;strokeWidth=1.5;fontColor=#e65100;fontSize=11;endArrow=classic;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="rtsrv" target="fw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1558" y="760"/><mxPoint x="1070" y="760"/></Array></mxGeometry></mxCell>
<mxCell id="e7" value="⑦ NAT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#e65100;strokeWidth=2;fontColor=#e65100;fontSize=11;endArrow=classic;labelBackgroundColor=#ffffff;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.85;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="pipfw" target="internet"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e8" value="⑧ LDAP (SSSD) · NFS 2049 (renders)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9b59b6;strokeWidth=1.5;fontColor=#9b59b6;fontSize=11;endArrow=classic;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="render" target="planos"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e11" value="⑪ SNMPv3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#0f766e;fontSize=11;endArrow=classic;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="planos" target="fw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1210" y="404"/><mxPoint x="1210" y="701"/></Array></mxGeometry></mxCell>
<mxCell id="legend" value="&lt;b&gt;Leyenda:&lt;/b&gt;&amp;nbsp; &lt;font color=&#x27;#1f6feb&#x27;&gt;■ flujo VPN y acceso a servicios&lt;/font&gt; &amp;nbsp;·&amp;nbsp; &lt;font color=&#x27;#2e7d32&#x27;&gt;■ web pública (DNAT)&lt;/font&gt; &amp;nbsp;·&amp;nbsp; &lt;font color=&#x27;#9b59b6&#x27;&gt;■ autenticación LDAP y archivos&lt;/font&gt; &amp;nbsp;·&amp;nbsp; &lt;font color=&#x27;#e65100&#x27;&gt;■ rutas UDR / salida a Internet (NAT)&lt;/font&gt; &amp;nbsp;·&amp;nbsp; &lt;font color=&#x27;#0f766e&#x27;&gt;■ monitoreo SNMP&lt;/font&gt; &amp;nbsp;·&amp;nbsp; punteado = retorno o secundario &amp;nbsp;·&amp;nbsp; ①–⑪ y Ⓐ–Ⓔ se explican en la tabla de flujo" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="950" width="1660" height="30" as="geometry"/></mxCell>
<mxCell id="tflujo" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Flujo paso a paso&lt;/b&gt;&lt;table border=&#x27;1&#x27; cellpadding=&#x27;5&#x27; style=&#x27;border-collapse:collapse;width:100%;font-size:12px;margin-top:8px&#x27;&gt;&lt;tr&gt;&lt;td&gt;①&lt;/td&gt;&lt;td&gt;El empleado abre el túnel OpenVPN de su grupo (1194 Arquitectos, 1195 Ingenieros, 1196 TI, 1197 Visitantes) hacia la IP pública de fw-vpn.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;②&lt;/td&gt;&lt;td&gt;fw-vpn valida usuario y contraseña contra OpenLDAP (srv-planos:389) y que el usuario sea del grupo de esa instancia.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;③&lt;/td&gt;&lt;td&gt;La instancia le da una IP dinámica de su pool, la ruta 10.0.0.0/16 y el DNS interno 10.0.0.20 (Visitantes recibe 1.1.1.1).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;④&lt;/td&gt;&lt;td&gt;Cada paquete pasa por nftables (cadena forward), que revisa origen, destino y puerto contra la ACL.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;⑤&lt;/td&gt;&lt;td&gt;Si se permite, llega al servidor con su IP real: SSH/SFTP a planos, SSH o intranet en render.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;⑥&lt;/td&gt;&lt;td&gt;El servidor responde a 10.10.1.x; la UDR de Servidores lo manda a fw-vpn, que lo regresa por el túnel.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;⑦&lt;/td&gt;&lt;td&gt;Servidores, DMZ y VPN salen a Internet por fw-vpn, que hace NAT con su IP pública.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;⑧&lt;/td&gt;&lt;td&gt;srv-planos y srv-render autentican SSH con LDAP (SSSD); los renders de Blender se guardan en planos por NFS.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;⑨&lt;/td&gt;&lt;td&gt;NTP: fw-vpn reparte la hora (UDP 123) a los 3 servidores.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;⑩&lt;/td&gt;&lt;td&gt;DNS interno: empleados y servidores preguntan a BIND9 (10.0.0.20) por nombres como planos.terranova.local.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;⑪&lt;/td&gt;&lt;td&gt;Prometheus en srv-planos consulta por SNMPv3 a las 4 VMs; Grafana lo grafica y solo lo abre TI.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Ⓐ&lt;/td&gt;&lt;td&gt;Un cliente abre https://terranova-inmobiliaria.me desde Internet, sin VPN.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Ⓑ&lt;/td&gt;&lt;td&gt;El DNS público responde con la IP pública de fw-vpn.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Ⓒ&lt;/td&gt;&lt;td&gt;La visita llega a fw-vpn por TCP 80 o 443; el NSG Firewall la permite.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Ⓓ&lt;/td&gt;&lt;td&gt;DNAT la reenvía a srv-web 10.0.0.4. nginx redirige HTTP a HTTPS y responde con el certificado de Let&#x27;s Encrypt.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Ⓔ&lt;/td&gt;&lt;td&gt;La respuesta vuelve por rt-dmz (0.0.0.0/0 → fw-vpn). La DMZ no puede iniciar conexiones hacia adentro.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1000" width="810" height="600" as="geometry"/></mxCell>
<mxCell id="tip" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Plan de direccionamiento&lt;/b&gt;&lt;table border=&#x27;1&#x27; cellpadding=&#x27;5&#x27; style=&#x27;border-collapse:collapse;width:100%;font-size:12px;margin-top:8px&#x27;&gt;&lt;tr&gt;&lt;th&gt;Subred&lt;/th&gt;&lt;th&gt;Dónde&lt;/th&gt;&lt;th&gt;Rango&lt;/th&gt;&lt;th&gt;IP útiles&lt;/th&gt;&lt;th&gt;Equipos&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;DMZ&lt;/td&gt;&lt;td&gt;Azure&lt;/td&gt;&lt;td&gt;10.0.0.0/28&lt;/td&gt;&lt;td&gt;11&lt;/td&gt;&lt;td&gt;srv-web 10.0.0.4 (sin IP pública)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Firewall&lt;/td&gt;&lt;td&gt;Azure&lt;/td&gt;&lt;td&gt;10.0.0.16/28&lt;/td&gt;&lt;td&gt;11&lt;/td&gt;&lt;td&gt;fw-vpn 10.0.0.20 · IP pública estática&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Servidores&lt;/td&gt;&lt;td&gt;Azure&lt;/td&gt;&lt;td&gt;10.0.0.32/28&lt;/td&gt;&lt;td&gt;11&lt;/td&gt;&lt;td&gt;srv-planos 10.0.0.36, srv-render 10.0.0.37&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Arquitectos&lt;/td&gt;&lt;td&gt;VPN&lt;/td&gt;&lt;td&gt;10.10.1.0/27&lt;/td&gt;&lt;td&gt;30&lt;/td&gt;&lt;td&gt;servidor .1 · laptops .2 a .30 · UDP 1194&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Ingenieros&lt;/td&gt;&lt;td&gt;VPN&lt;/td&gt;&lt;td&gt;10.10.1.32/28&lt;/td&gt;&lt;td&gt;14&lt;/td&gt;&lt;td&gt;servidor .33 · laptops .34 a .46 · UDP 1195&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;TI&lt;/td&gt;&lt;td&gt;VPN&lt;/td&gt;&lt;td&gt;10.10.1.48/29&lt;/td&gt;&lt;td&gt;6&lt;/td&gt;&lt;td&gt;servidor .49 · laptops .50 a .54 · UDP 1196&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Visitantes&lt;/td&gt;&lt;td&gt;VPN&lt;/td&gt;&lt;td&gt;10.10.1.64/28&lt;/td&gt;&lt;td&gt;14&lt;/td&gt;&lt;td&gt;servidor .65 · laptops .66 a .78 · UDP 1197&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&#x27;font-size:11px;margin-top:6px&#x27;&gt;Azure reserva 5 IP por subred, por eso la primera usable es la .4. DHCP: Azure da la IP a las VMs; cada instancia de OpenVPN da IPs dinámicas de su pool a las laptops.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="870" y="1000" width="810" height="330" as="geometry"/></mxCell>
<mxCell id="tdns" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Zona DNS interna terranova.local (BIND9 en fw-vpn)&lt;/b&gt;&lt;table border=&#x27;1&#x27; cellpadding=&#x27;5&#x27; style=&#x27;border-collapse:collapse;width:100%;font-size:12px;margin-top:8px&#x27;&gt;&lt;tr&gt;&lt;th&gt;Nombre&lt;/th&gt;&lt;th&gt;IP&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;fw · ntp · dns · vpn&lt;/td&gt;&lt;td&gt;10.0.0.20&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;web&lt;/td&gt;&lt;td&gt;10.0.0.4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;planos · ldap · grafana&lt;/td&gt;&lt;td&gt;10.0.0.36&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;render · intranet&lt;/td&gt;&lt;td&gt;10.0.0.37&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&#x27;font-size:11px;margin-top:6px&#x27;&gt;Responde a la red interna y a la VPN de Arquitectos, Ingenieros y TI; no a Visitantes ni a Internet. Lo demás lo reenvía al DNS de Azure (168.63.129.16). El dominio público es aparte: lo resuelve el DNS del registrador.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="870" y="1360" width="810" height="250" as="geometry"/></mxCell>
<mxCell id="tudr" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Tablas de rutas (UDR)&lt;/b&gt;&lt;table border=&#x27;1&#x27; cellpadding=&#x27;5&#x27; style=&#x27;border-collapse:collapse;width:100%;font-size:12px;margin-top:8px&#x27;&gt;&lt;tr&gt;&lt;th&gt;Tabla&lt;/th&gt;&lt;th&gt;Destino&lt;/th&gt;&lt;th&gt;Siguiente salto&lt;/th&gt;&lt;th&gt;Para qué&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;rt-servidores&lt;/td&gt;&lt;td&gt;10.10.0.0/16&lt;/td&gt;&lt;td&gt;10.0.0.20&lt;/td&gt;&lt;td&gt;Respuestas a los usuarios de la VPN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;rt-servidores&lt;/td&gt;&lt;td&gt;0.0.0.0/0&lt;/td&gt;&lt;td&gt;10.0.0.20&lt;/td&gt;&lt;td&gt;Salida a Internet con NAT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;rt-servidores&lt;/td&gt;&lt;td&gt;10.0.0.0/28&lt;/td&gt;&lt;td&gt;10.0.0.20&lt;/td&gt;&lt;td&gt;Tráfico hacia la DMZ pasa por el firewall&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;rt-dmz&lt;/td&gt;&lt;td&gt;0.0.0.0/0&lt;/td&gt;&lt;td&gt;10.0.0.20&lt;/td&gt;&lt;td&gt;Respuestas del DNAT y salida a Internet de srv-web&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;rt-dmz&lt;/td&gt;&lt;td&gt;10.10.0.0/16&lt;/td&gt;&lt;td&gt;10.0.0.20&lt;/td&gt;&lt;td&gt;Respuestas a los usuarios de la VPN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;rt-dmz&lt;/td&gt;&lt;td&gt;10.0.0.32/28&lt;/td&gt;&lt;td&gt;10.0.0.20&lt;/td&gt;&lt;td&gt;Tráfico hacia Servidores pasa por el firewall&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Subred Firewall&lt;/td&gt;&lt;td&gt;sin UDR&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;Evita que fw-vpn se mande tráfico a sí mismo&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&#x27;font-size:11px;margin-top:6px&#x27;&gt;Requisitos en Azure: IP forwarding en la NIC de fw-vpn y su IP privada estática.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1630" width="810" height="330" as="geometry"/></mxCell>
<mxCell id="tacl" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;ACL (nftables en fw-vpn + NSG + firewall de cada VM)&lt;/b&gt;&lt;table border=&#x27;1&#x27; cellpadding=&#x27;5&#x27; style=&#x27;border-collapse:collapse;width:100%;font-size:12px;margin-top:8px&#x27;&gt;&lt;tr&gt;&lt;th&gt;Origen → Destino&lt;/th&gt;&lt;th&gt;srv-planos&lt;/th&gt;&lt;th&gt;srv-render&lt;/th&gt;&lt;th&gt;Intranet&lt;/th&gt;&lt;th&gt;srv-web&lt;/th&gt;&lt;th&gt;Grafana&lt;/th&gt;&lt;th&gt;TI&lt;/th&gt;&lt;th&gt;Internet&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Arquitectos&lt;/td&gt;&lt;td&gt;✔ SSH, SFTP&lt;/td&gt;&lt;td&gt;✔ SSH&lt;/td&gt;&lt;td&gt;✔&lt;/td&gt;&lt;td&gt;✔&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;✔ NAT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Ingenieros&lt;/td&gt;&lt;td&gt;✔ SSH, SFTP (lectura)&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;✔&lt;/td&gt;&lt;td&gt;✔&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;✔ NAT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;TI&lt;/td&gt;&lt;td&gt;✔ todo&lt;/td&gt;&lt;td&gt;✔ todo&lt;/td&gt;&lt;td&gt;✔&lt;/td&gt;&lt;td&gt;✔ + SSH&lt;/td&gt;&lt;td&gt;✔&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;✔ NAT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Visitantes&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;✔ (dominio)&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;✔ NAT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;DMZ (srv-web)&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;✔ NAT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Servidores&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;✔&lt;/td&gt;&lt;td&gt;solo SNMP (planos)&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;✔ NAT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Internet&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;✔ 80/443 vía DNAT&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;td&gt;UDP 1194–1197 → fw-vpn&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&#x27;font-size:11px;margin-top:6px&#x27;&gt;Política por defecto: DROP. Nadie puede iniciar conexión hacia TI; TI sí recibe sus respuestas. Solo quedan abiertos los puertos de esta tabla (hardening).&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="870" y="1640" width="810" height="360" as="geometry"/></mxCell>
<mxCell id="tnsg" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Grupos de seguridad (NSG)&lt;/b&gt;&lt;table border=&#x27;1&#x27; cellpadding=&#x27;5&#x27; style=&#x27;border-collapse:collapse;width:100%;font-size:12px;margin-top:8px&#x27;&gt;&lt;tr&gt;&lt;th&gt;NSG&lt;/th&gt;&lt;th&gt;Reglas clave&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;nsg-firewall&lt;/td&gt;&lt;td&gt;Entrada: UDP 1194–1197 y TCP 80/443 desde Internet; SSH solo admin; DNS/NTP internos; salida de Servidores y DMZ; SNMP del colector. Salida: VPN → red y DNAT → 10.0.0.4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;nsg-dmz&lt;/td&gt;&lt;td&gt;80/443 desde cualquiera; SSH e ICMP solo desde fw-vpn y TI; SNMP desde 10.0.0.36; resto denegado&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;nsg-servidores&lt;/td&gt;&lt;td&gt;Reglas por grupo (Fase 3); la DMZ y Visitantes fuera de todas; NFS render → planos; SNMP del colector; sin 445&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1990" width="810" height="230" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
