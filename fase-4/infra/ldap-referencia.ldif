# Directorio de srv-planos en la Fase 3, exportado con `slapcat -n 1` el 10 nov 2026.
# Sin userPassword ni atributos operacionales. setup-ldap.sh recrea exactamente esto.
#
# Configuración (cn=config): slapd 2.5.20 (Ubuntu 22.04), backend mdb en /var/lib/ldap,
# rootDN cn=admin,dc=terranova,dc=local, escucha ldap:/// (389) y ldapi:///, sin TLS.
# Esquemas: core, cosine, nis, inetorgperson. Sin overlays.
# Índices: objectClass eq · cn,uid eq · uidNumber,gidNumber eq · member,memberUid eq
# ACL (las de Ubuntu por defecto):
#   {0} to attrs=userPassword by self write by anonymous auth by * none
#   {1} to attrs=shadowLastChange by self write by * read
#   {2} to * by * read

dn: dc=terranova,dc=local
objectClass: top
objectClass: dcObject
objectClass: organization
o: Terranova
dc: terranova

dn: ou=usuarios,dc=terranova,dc=local
objectClass: organizationalUnit
ou: usuarios

dn: ou=grupos,dc=terranova,dc=local
objectClass: organizationalUnit
ou: grupos

dn: uid=ana.arq,ou=usuarios,dc=terranova,dc=local
objectClass: inetOrgPerson
objectClass: posixAccount
objectClass: shadowAccount
uid: ana.arq
cn: Ana Arquitecta
givenName: Ana
sn: Arquitecta
uidNumber: 10001
gidNumber: 20001
homeDirectory: /home/ana.arq
loginShell: /bin/bash

