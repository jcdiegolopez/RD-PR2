<mxfile host="app.diagrams.net"><diagram name="Fase 3" id="fase3"><mxGraphModel adaptiveColors="auto" dx="1600" dy="1000" grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Caso 4 · Terranova — Red en Azure, Fase 3 (servicios y seguridad)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1100" height="40" as="geometry"/></mxCell><mxCell id="internet" value="&lt;b&gt;Internet&lt;/b&gt;" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=16;" vertex="1" parent="1"><mxGeometry x="690" y="60" width="200" height="110" as="geometry"/></mxCell><mxCell id="users" value="Usuarios por VPN (laptops) · 4 instancias de OpenVPN" style="swimlane;startSize=30;html=1;fillColor=#fff4e5;strokeColor=#b45309;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="330" height="580" as="geometry"/></mxCell><mxCell id="arq" value="&lt;b&gt;Arquitectos&lt;/b&gt; (15)&lt;br&gt;10.10.1.0/27 · UDP 1194&lt;br&gt;&lt;small&gt;IPs dinámicas .2 – .30&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="users"><mxGeometry x="25" y="45" width="280" height="80" as="geometry"/></mxCell><mxCell id="ing" value="&lt;b&gt;Ingenieros&lt;/b&gt; (10)&lt;br&gt;10.10.1.32/28 · UDP 1195&lt;br&gt;&lt;small&gt;IPs dinámicas .34 – .46&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="users"><mxGeometry x="25" y="160" width="280" height="80" as="geometry"/></mxCell><mxCell id="ti" value="&lt;b&gt;TI&lt;/b&gt; (3)&lt;br&gt;10.10.1.48/29 · UDP 1196&lt;br&gt;&lt;small&gt;IPs dinámicas .50 – .54 · nadie inicia hacia TI&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="users"><mxGeometry x="25" y="275" width="280" height="80" as="geometry"/></mxCell><mxCell id="vis" value="&lt;b&gt;Visitantes&lt;/b&gt; (nueva)&lt;br&gt;10.10.1.64/28 · UDP 1197&lt;br&gt;&lt;small&gt;Solo Internet, nada interno&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;dashed=1;" vertex="1" parent="users"><mxGeometry x="25" y="390" width="280" height="80" as="geometry"/></mxCell><mxCell id="ldapnote" value="Login de VPN con usuario de LDAP; cada instancia solo acepta a su grupo" style="text;html=1;whiteSpace=wrap;fontSize=13;align=center;fontColor=#7c2d12;" vertex="1" parent="users"><mxGeometry x="25" y="490" width="280" height="60" as="geometry"/></mxCell><mxCell id="vnet" value="vnet-proyecto · 10.0.0.0/16 · Azure for Students, North Central US" style="swimlane;startSize=30;html=1;fillColor=#eaf3fb;strokeColor=#0078d4;fontSize=14;dashed=1;" vertex="1" parent="1"><mxGeometry x="430" y="220" width="1080" height="580" as="geometry"/></mxCell><mxCell id="dmz" value="Subred DMZ · 10.0.0.0/28" style="swimlane;startSize=26;html=1;fillColor=#f1f8e9;strokeColor=#2e7d32;fontSize=14;dashed=1;" vertex="1" parent="vnet"><mxGeometry x="20" y="45" width="210" height="510" as="geometry"/></mxCell><mxCell id="dmztxt" value="Vacía y reservada&lt;br&gt;&lt;small&gt;Sin cuota para otra VM. La web pública queda para la fase final. nsg-dmz sin entrada desde Internet&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=14;dashed=1;" vertex="1" parent="dmz"><mxGeometry x="15" y="190" width="180" height="130" as="geometry"/></mxCell><mxCell id="fwnet" value="Subred Firewall · 10.0.0.16/28" style="swimlane;startSize=26;html=1;fillColor=#e8f5f3;strokeColor=#0f766e;fontSize=14;dashed=1;" vertex="1" parent="vnet"><mxGeometry x="250" y="45" width="370" height="510" as="geometry"/></mxCell><mxCell id="pip" value="IP pública fw-vpn" style="image;aspect=fixed;html=1;align=center;fontSize=14;verticalLabelPosition=bottom;verticalAlign=top;image=https://app.diagrams.net/img/lib/azure2/networking/Public_IP_Addresses.svg;labelPerimeter=1;" vertex="1" parent="fwnet"><mxGeometry x="152" y="40" width="65" height="52" as="geometry"/></mxCell><mxCell id="fw" value="&lt;b&gt;fw-vpn · 10.0.0.20&lt;/b&gt; (IP fija)&lt;hr&gt;• OpenVPN ×4 (UDP 1194–1197)&lt;br&gt;• nftables: ACL por subred&lt;br&gt;• NAT (MASQUERADE) a Internet&lt;br&gt;• IP forwarding (Linux + NIC)&lt;br&gt;• chrony: servidor NTP&lt;br&gt;• Hardening: input DROP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f3f0;strokeColor=#0f766e;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=14;" vertex="1" parent="fwnet"><mxGeometry x="35" y="150" width="300" height="200" as="geometry"/></mxCell><mxCell id="nsgfw" value="nsg-firewall: UDP 1194–1197 desde Internet · SSH solo admin · sin UDR (evita loop)" style="text;html=1;whiteSpace=wrap;fontSize=13;align=center;fontColor=#475569;" vertex="1" parent="fwnet"><mxGeometry x="35" y="400" width="300" height="60" as="geometry"/></mxCell><mxCell id="srvnet" value="Subred Servidores · 10.0.0.32/28" style="swimlane;startSize=26;html=1;fillColor=#f3eefa;strokeColor=#8e44ad;fontSize=14;dashed=1;" vertex="1" parent="vnet"><mxGeometry x="640" y="45" width="420" height="510" as="geometry"/></mxCell><mxCell id="planos" value="&lt;b&gt;srv-planos · 10.0.0.36&lt;/b&gt;&lt;br&gt;OpenLDAP (389) · usuarios y grupos&lt;br&gt;SSH 22 con usuarios LDAP (SSSD)&lt;br&gt;&lt;small&gt;NTP desde fw-vpn · sin IP pública&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="srvnet"><mxGeometry x="40" y="45" width="340" height="105" as="geometry"/></mxCell><mxCell id="render" value="&lt;b&gt;srv-render · 10.0.0.37&lt;/b&gt;&lt;br&gt;nginx: intranet (HTTP 80, solo interno)&lt;br&gt;SSH 22 con usuarios LDAP (SSSD)&lt;br&gt;&lt;small&gt;NTP desde fw-vpn · sin IP pública&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="srvnet"><mxGeometry x="40" y="215" width="340" height="105" as="geometry"/></mxCell><mxCell id="udr" value="&lt;b&gt;rt-servidores&lt;/b&gt; (UDR)&lt;br&gt;0.0.0.0/0 y 10.10.0.0/16 → 10.0.0.20" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="srvnet"><mxGeometry x="40" y="370" width="340" height="60" as="geometry"/></mxCell><mxCell id="nsgsrv" value="nsg-servidores: reglas por grupo · Visitantes bloqueado · Deny-Resto" style="text;html=1;whiteSpace=wrap;fontSize=13;align=center;fontColor=#475569;" vertex="1" parent="srvnet"><mxGeometry x="40" y="445" width="340" height="40" as="geometry"/></mxCell><mxCell id="e1" value="Túnel OpenVPN" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1f6feb;strokeWidth=2;fontColor=#1f6feb;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="1" source="users" target="internet"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="UDP 1194–1197" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1f6feb;strokeWidth=2;fontColor=#1f6feb;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="1" source="internet" target="pip"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1f6feb;strokeWidth=2;" edge="1" parent="fwnet" source="pip" target="fw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="LDAP 389 (login VPN)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9b59b6;strokeWidth=2;fontColor=#7b3fa0;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="vnet" source="fw" target="planos"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="HTTP 80 · SSH 22 (según ACL)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1f6feb;strokeWidth=2;fontColor=#1f6feb;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="vnet" source="fw" target="render"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="LDAP (SSSD)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9b59b6;strokeWidth=2;dashed=1;fontColor=#7b3fa0;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="srvnet" source="render" target="planos"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="NAT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#e65100;strokeWidth=2;fontColor=#e65100;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="1" source="fw" target="internet"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="respuestas y salida" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#e65100;strokeWidth=2;dashed=1;fontColor=#e65100;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="vnet" source="udr" target="fw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="dhcp" value="&lt;b&gt;DHCP:&lt;/b&gt; Azure da la IP a las VMs (.20, .36, .37 fijas) · OpenVPN da IPs dinámicas por grupo a las laptops" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="700" height="50" as="geometry"/></mxCell><mxCell id="acl" value="&lt;b&gt;ACL (nftables + NSG):&lt;/b&gt; TI → todo · nadie inicia hacia TI · Arquitectos → planos y render · Ingenieros → planos y solo la web de render · Visitantes → solo Internet · Intranet: todos menos Visitantes e Internet · Política por defecto: DROP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="770" y="830" width="740" height="70" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Leyenda:&lt;/b&gt; &lt;font color=&quot;#1f6feb&quot;&gt;■ VPN y acceso a servicios&lt;/font&gt; · &lt;font color=&quot;#7b3fa0&quot;&gt;■ autenticación LDAP&lt;/font&gt; · &lt;font color=&quot;#e65100&quot;&gt;■ rutas y NAT&lt;/font&gt; · punteado = retorno o secundario · rojo punteado = subred nueva" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="910" width="1470" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
